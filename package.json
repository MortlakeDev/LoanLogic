{
  "name": "loanlogic",
  "version": "0.0.0",
  "private": true,
  "description": "A precise, private loan & savings calculator that runs entirely in the browser.",
  "license": "AGPL-3.0-or-later",
  "author": "Mortlake",
  "homepage": "https://github.com/MortlakeDev/LoanLogic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MortlakeDev/LoanLogic.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.engine.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "npm run build && npm run build:single && playwright test",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:spdx && npm run check:licenses && npm run coverage && npm run build && npm run build:single && npm run check:size"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "decimal.js": "^10.6.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
